<Window x:Class="IdleRunner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Idle Runner"
        Width="1080"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <Storyboard x:Key="EntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="Workspace"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetName="WorkspaceTransform"
                             Storyboard.TargetProperty="Y"
                             From="8"
                             To="0"
                             Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="UtilityButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{StaticResource SurfaceRaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0,0,26,13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <ContentPresenter x:Name="HeaderContent"
                                              Margin="{TemplateBinding Padding}"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                            <Border x:Name="SelectionIndicator"
                                    Height="2"
                                    Margin="0,0,26,0"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="Background"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavigationTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" />
                            <Border Grid.Row="1" Background="{StaticResource DividerBrush}" />
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="2"
                                              ContentSource="SelectedContent"
                                              KeyboardNavigation.DirectionalNavigation="Contained" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box"
                                Width="18"
                                Height="18"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Path x:Name="Mark"
                                  Width="10"
                                  Height="8"
                                  Data="M 1,4 L4,7 L9,1"
                                  Stretch="Fill"
                                  Stroke="#111318"
                                  StrokeThickness="2"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PendingLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Workspace" Opacity="0" Margin="34,28,34,30">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="WorkspaceTransform" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="IDLE RUNNER"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Automation control"
                           Margin="0,6,0,0"
                           FontSize="23"
                           FontWeight="SemiBold" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="MIGRATION BUILD"
                           Style="{StaticResource SectionLabelStyle}"
                           HorizontalAlignment="Right" />
                <TextBlock Text="C# / Windows"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource DividerBrush}" />

        <TabControl Grid.Row="2"
                    Margin="0,22,0,0"
                    SelectedIndex="0"
                    Style="{StaticResource NavigationTabControlStyle}">
            <TabItem Header="AUTOMATION">
                <Grid Margin="0,30,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,42,0">
                <TextBlock Text="CURRENT STATE" Style="{StaticResource SectionLabelStyle}" />

                <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                    <Ellipse Width="12"
                             Height="12"
                             Margin="0,7,12,0"
                             VerticalAlignment="Top"
                             Fill="{Binding StatusBrush}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1"
                                                                     To="0.42"
                                                                     Duration="0:0:0.8"
                                                                     AutoReverse="True"
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusTitle}"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusDetail}"
                                   Margin="0,7,0,0"
                                   MaxWidth="350"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <Button Margin="0,34,0,0"
                        Content="{Binding PrimaryActionText}"
                        IsEnabled="{Binding IsPrimaryActionEnabled}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnPrimaryActionClick" />

                <TextBlock Margin="0,11,0,0"
                           Text="{Binding CommandCountLabel}"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" />

                <Grid Margin="0,34,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="JUMP INTERVAL" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding JumpIntervalLabel}"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <Slider Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,13,0,0"
                            Minimum="25"
                            Maximum="1000"
                            TickFrequency="25"
                            IsSnapToTickEnabled="True"
                            Value="{Binding JumpIntervalMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <StackPanel Margin="0,30,0,0">
                    <TextBlock Text="VISUAL SAFETY" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding GameplayCalibrationStatus}"
                               Style="{StaticResource SettingDescriptionStyle}" />
                    <Button Margin="0,13,0,0"
                            Content="Calibrate gameplay screen"
                            IsEnabled="{Binding IsCalibrationEnabled}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnCalibrateGameplayClick" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Use the normal gameplay view with menus closed. Calibration always pauses automation."
                               Style="{StaticResource SettingDescriptionStyle}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />

            <Grid Grid.Column="2" Margin="42,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="SAFETY GATES" Style="{StaticResource SectionLabelStyle}" />
                <StackPanel Grid.Row="1" Margin="0,18,0,25">
                    <TextBlock Text="✓ Starts paused" Margin="0,0,0,9" />
                    <TextBlock Text="✓ Idle Slayer must be foreground" Margin="0,0,0,9" />
                    <TextBlock Text="✓ Client area must be 1280 × 720" Margin="0,0,0,9" />
                    <TextBlock Text="✓ Single application instance" Margin="0,0,0,9" />
                    <TextBlock Text="✓ Mouse jump + boost, 35 ms pulse" Margin="0,0,0,9" />
                    <TextBlock Text="✓ Cursor parked safely while running" Margin="0,0,0,9" />
                    <TextBlock Text="Home toggles · Shift+Esc exits" />
                </StackPanel>

                <Border Grid.Row="2" Background="{StaticResource DividerBrush}" />

                <Grid Grid.Row="3" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ACTIVITY"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionLabelStyle}" />
                    <Button Grid.Column="1"
                            Content="Copy all"
                            ToolTip="Copy the complete activity log"
                            Style="{StaticResource UtilityButtonStyle}"
                            Click="OnCopyActivityClick" />
                </Grid>

                <TextBox Grid.Row="4"
                         Margin="0,13,0,0"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="11"
                         Foreground="{StaticResource MutedTextBrush}"
                         SelectionBrush="{StaticResource AccentBrush}"
                         SelectionOpacity="0.28"
                         Text="{Binding ActivityText, Mode=OneWay}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         ToolTip="Select any text and press Ctrl+C to copy it" />
            </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="GENERAL">
                <ScrollViewer Margin="0,30,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,42,0">
                            <TextBlock Text="AUTOMATION SCHEDULE" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Margin="0,7,0,28"
                                       Text="Values are saved immediately. Scheduled modules will use them as they are migrated."
                                       Style="{StaticResource SettingDescriptionStyle}" />

                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding AutoBuyUpgradesEnabled}"
                                          AutomationProperties.Name="Auto buy upgrades"
                                          Style="{StaticResource SettingsCheckBoxStyle}" />
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="Auto buy upgrades" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Buy eligible equipment and upgrades on a timer."
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                    <StackPanel Margin="0,11,0,0" Orientation="Horizontal">
                                        <TextBox Text="{Binding AutoBuyIntervalMinutes, UpdateSourceTrigger=LostFocus}"
                                                 AutomationProperties.Name="Auto buy interval in minutes"
                                                 Style="{StaticResource SettingsTextBoxStyle}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="minutes"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="MODULE PENDING" Style="{StaticResource PendingLabelStyle}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding AutoAscendEnabled}"
                                          AutomationProperties.Name="Auto ascend"
                                          Style="{StaticResource SettingsCheckBoxStyle}" />
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="Auto ascend" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Perform an ascension after the configured interval."
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                    <StackPanel Margin="0,11,0,0" Orientation="Horizontal">
                                        <TextBox Text="{Binding AutoAscendIntervalMinutes, UpdateSourceTrigger=LostFocus}"
                                                 AutomationProperties.Name="Auto ascend interval in minutes"
                                                 Style="{StaticResource SettingsTextBoxStyle}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="minutes"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="MODULE PENDING" Style="{StaticResource PendingLabelStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />

                        <StackPanel Grid.Column="2" Margin="42,0,0,0">
                            <TextBlock Text="GAMEPLAY RULES" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Margin="0,7,0,28"
                                       Text="Legacy behavior is preserved as configuration while its visual modules are rebuilt."
                                       Style="{StaticResource SettingDescriptionStyle}" />

                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding CollectSilverBoxesEnabled}"
                                          AutomationProperties.Name="Collect Silver Boxes"
                                          Style="{StaticResource SettingsCheckBoxStyle}" />
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="Collect Silver Boxes" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Claim the top-screen Silver Box only after its calibrated icon is recognized."
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                    <TextBlock Text="{Binding SilverBoxCalibrationStatus}"
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                    <Button Margin="0,12,0,0"
                                            Content="Calibrate visible Silver Box icon"
                                            IsEnabled="{Binding IsCalibrationEnabled}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OnCalibrateSilverBoxClick" />
                                    <TextBlock Text="MODULE READY" Style="{StaticResource PendingLabelStyle}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding CirclePortalsEnabled}"
                                          AutomationProperties.Name="Cycle portals"
                                          Style="{StaticResource SettingsCheckBoxStyle}" />
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="Cycle portals" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Use the next portal destination when the portal is ready."
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                    <StackPanel Margin="0,11,0,0" Orientation="Horizontal">
                                        <TextBox Text="{Binding PortalCyclePosition, UpdateSourceTrigger=LostFocus}"
                                                 AutomationProperties.Name="Next portal destination index"
                                                 Style="{StaticResource SettingsTextBoxStyle}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="next index (1-9)"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="MODULE PENDING" Style="{StaticResource PendingLabelStyle}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding DisableRageWithoutSoulBonus}"
                                          AutomationProperties.Name="Limit rage to Soul Bonus"
                                          Style="{StaticResource SettingsCheckBoxStyle}" />
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="Limit rage to Soul Bonus" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Do not use rage on a Mega Horde unless Soul Bonus is active."
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                    <TextBlock Text="MODULE PENDING" Style="{StaticResource PendingLabelStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="MINIGAMES">
                <ScrollViewer Margin="0,30,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="MINIGAME STRATEGY" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Margin="0,7,0,28"
                                   Text="These options match the original Idle Runner configuration. Their automation modules are still being migrated."
                                   Style="{StaticResource SettingDescriptionStyle}" />

                        <Grid Margin="0,0,0,28">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding SkipBonusStage}"
                                      AutomationProperties.Name="Skip bonus stage"
                                      Style="{StaticResource SettingsCheckBoxStyle}" />
                            <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                <TextBlock Text="Skip bonus stage" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="Let the bonus-stage timer expire without running a stage sequence."
                                           Style="{StaticResource SettingDescriptionStyle}" />
                                <TextBlock Text="MODULE PENDING" Style="{StaticResource PendingLabelStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,28">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding NoLockpicking}"
                                      AutomationProperties.Name="No Lockpicking divinity"
                                      Style="{StaticResource SettingsCheckBoxStyle}" />
                            <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                <TextBlock Text="No Lockpicking divinity" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="Use longer Chest Hunt waits when Lockpicking is unavailable."
                                           Style="{StaticResource SettingDescriptionStyle}" />
                                <TextBlock Text="MODULE PENDING" Style="{StaticResource PendingLabelStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,28">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding NoReinforcedCrystalSaver}"
                                      AutomationProperties.Name="No Reinforced Crystal Saver"
                                      Style="{StaticResource SettingsCheckBoxStyle}" />
                            <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                <TextBlock Text="No Reinforced Crystal Saver" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="Adjust the Chest Hunt strategy when the permanent saver is unavailable."
                                           Style="{StaticResource SettingDescriptionStyle}" />
                                <TextBlock Text="MODULE PENDING" Style="{StaticResource PendingLabelStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,28">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding PerfectChestHunt}"
